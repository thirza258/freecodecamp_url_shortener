SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,url.nevatal.id,nevatal.id

POSTGRES_DB=nevatal_url_shortener
POSTGRES_USER=nevatal
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1

DOMAIN_NAME=url.nevatal.id
PUBLIC_SHORT_DOMAIN=url.nevatal.id

# Who may embed this site in an iframe. "*" = any site (default), or a
# comma-separated list of origins, e.g. https://nevatal.id,https://example.com.
# Use "none" to block all embedding.
FRAME_ANCESTORS=*

# Only needed when embedding the site in an iframe on ANOTHER domain and
# submitting forms there: set both to None and make sure the *_COOKIE_SECURE
# flags stay enabled (Django requires them with SameSite=None).
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
